[{"level":6,"section":"grammar","q":"他的表现 ___ 令人失望。","choices":["不禁","不妨","不免","不曾"],"answer":2,"note":"「不免」表示这种反应免不了会产生。"},{"level":6,"section":"grammar","q":"事情还没查清，___ 下结论。","choices":["不曾","不必","不宜","不至于"],"answer":2,"note":"「不宜」表示现在这样做不合适。"},{"level":6,"section":"grammar","q":"这点小事，___ 惊动大家。","choices":["何必","何况","何以","何尝"],"answer":0,"note":"「何必」用反问表示没有这个必要。"},{"level":6,"section":"grammar","q":"___ 抱怨，___ 想办法解决。","choices":["与其…不如","宁可…也不","不是…就是","即使…也"],"answer":0,"note":"「与其…不如」否定前一种做法，选择后一种。"},{"level":6,"section":"grammar","q":"___ 明天下雨，运动会就延期。","choices":["既然","尽管","以致","倘若"],"answer":3,"note":"「倘若」是书面语的「如果」，多用于正式文字。"},{"level":6,"section":"grammar","q":"他每天早起，___ 是为了多读一小时书。","choices":["无从","无奈","无非","无论"],"answer":2,"note":"「无非」表示原因不过如此，没有别的。"},{"level":6,"section":"grammar","q":"他工作粗心，___ 出了大问题。","choices":["以免","从而","以便","以致"],"answer":3,"note":"「以致」引出不好的结果。"},{"level":6,"section":"grammar","q":"___ 条件艰苦，他 ___ 坚持了下来。","choices":["尽管…还是","既然…就","只要…就","无论…也"],"answer":0,"note":"「尽管…还是」先承认困难确实存在，再说明结果并未改变。"},{"level":6,"section":"grammar","q":"事情还没查清， ___ 下结论。","choices":["不必","不至于","不宜","不曾"],"answer":2,"note":"「不宜」表示现在这样做不合适，「不必」表示没有必要。","point":"buyi"},{"level":6,"section":"grammar","q":"饭后 ___ 马上运动。","choices":["不必","不宜","不至于","不曾"],"answer":1,"note":"「不宜」表示现在这样做不合适，「不必」表示没有必要。","point":"buyi"},{"level":6,"section":"grammar","q":"此事 ___ 公开。","choices":["不必","不曾","不宜","不至于"],"answer":2,"note":"「不宜」表示现在这样做不合适，「不必」表示没有必要。","point":"buyi"},{"level":6,"section":"grammar","q":"「事情还没查清，不宜下结论。」用的是哪个格式？","choices":["哪怕 A，也 B","万一 A，就 B","不宜 + V","无非 (是) ……"],"answer":2,"note":"「不宜」表示现在这样做不合适，「不必」表示没有必要。","point":"buyi"},{"level":6,"section":"grammar","q":"哪一句用了「不宜 + V」？","choices":["事情还没查清，不宜下结论。","请提前通知，以免影响工作。","他先是吃惊，继而笑了。","所谓效率，就是用最少的时间做最多的事。"],"answer":0,"note":"「不宜」表示现在这样做不合适，「不必」表示没有必要。","point":"buyi"},{"level":6,"section":"grammar","q":"他 ___ 发脾气。","choices":["经常","动辄","总是","往往"],"answer":1,"note":"「动辄」表示动不动就这样，带批评的意思。","point":"dongzhe"},{"level":6,"section":"grammar","q":" ___ 批评别人是不对的。","choices":["总是","往往","动辄","经常"],"answer":2,"note":"「动辄」表示动不动就这样，带批评的意思。","point":"dongzhe"},{"level":6,"section":"grammar","q":"价格 ___ 上万。","choices":["经常","动辄","总是","往往"],"answer":1,"note":"「动辄」表示动不动就这样，带批评的意思。","point":"dongzhe"},{"level":6,"section":"grammar","q":"「他动辄发脾气。」用的是哪个格式？","choices":["未免 + Adj","动辄 + V","诚然 A，但 B","惟独 A ……"],"answer":1,"note":"「动辄」表示动不动就这样，带批评的意思。","point":"dongzhe"},{"level":6,"section":"grammar","q":"哪一句用了「动辄 + V」？","choices":["他动辄发脾气。","宁可走路，也不坐那么久的车。","与其抱怨，不如想办法解决。","大家都同意，惟独他反对。"],"answer":0,"note":"「动辄」表示动不动就这样，带批评的意思。","point":"dongzhe"},{"level":6,"section":"grammar","q":"这点小事， ___ 惊动大家。","choices":["何以","何况","何必","难道"],"answer":2,"note":"「何必」用反问表示没有这个必要，「何况」是更进一层。","point":"hebi"},{"level":6,"section":"grammar","q":"他已经道歉了，你 ___ 生气？","choices":["何况","何以","何必","难道"],"answer":2,"note":"「何必」用反问表示没有这个必要，「何况」是更进一层。","point":"hebi"},{"level":6,"section":"grammar","q":" ___ 这么着急？","choices":["何必","何以","难道","何况"],"answer":0,"note":"「何必」用反问表示没有这个必要，「何况」是更进一层。","point":"hebi"},{"level":6,"section":"grammar","q":"「这点小事，何必惊动大家。」用的是哪个格式？","choices":["何必 …… ？","一经 A，就 B","在 N 看来","……，好让 ……"],"answer":0,"note":"「何必」用反问表示没有这个必要，「何况」是更进一层。","point":"hebi"},{"level":6,"section":"grammar","q":"哪一句用了「何必 …… ？」？","choices":["这点小事，何必惊动大家。","这个问题姑且不谈。","他不禁笑了起来。","凭票入场。"],"answer":0,"note":"「何必」用反问表示没有这个必要，「何况」是更进一层。","point":"hebi"},{"level":6,"section":"grammar","q":"他先是吃惊， ___ 笑了。","choices":["然后","继而","进而","于是"],"answer":1,"note":"「继而」表示紧接着发生的下一步，比「然后」正式。","point":"jier"},{"level":6,"section":"grammar","q":"雨点落下， ___ 成了大雨。","choices":["进而","继而","然后","先"],"answer":1,"note":"「继而」表示紧接着发生的下一步，比「然后」正式。","point":"jier"},{"level":6,"section":"grammar","q":"先试点， ___ 推广。","choices":["然后","继而","于是","进而"],"answer":1,"note":"「继而」表示紧接着发生的下一步，比「然后」正式。","point":"jier"},{"level":6,"section":"grammar","q":"「他先是吃惊，继而笑了。」用的是哪个格式？","choices":["S 却 V","一来 A，二来 B","凭 + N","先 ……，继而 ……"],"answer":3,"note":"「继而」表示紧接着发生的下一步，比「然后」正式。","point":"jier"},{"level":6,"section":"grammar","q":"哪一句用了「先 ……，继而 ……」？","choices":["刚开始免不了会出错。","这本书值得看。","倘若明天下雨，运动会就延期。","他先是吃惊，继而笑了。"],"answer":3,"note":"「继而」表示紧接着发生的下一步，比「然后」正式。","point":"jier"},{"level":6,"section":"grammar","q":" ___ 发现，立即处理。","choices":["一旦","只要","一经","一"],"answer":2,"note":"「一经」表示经过这一步以后事情就定了，语体正式。","point":"jingguo"},{"level":6,"section":"grammar","q":"合同 ___ 签订就生效。","choices":["一经","一旦","一","只要"],"answer":0,"note":"「一经」表示经过这一步以后事情就定了，语体正式。","point":"jingguo"},{"level":6,"section":"grammar","q":" ___ 录用，待遇从优。","choices":["一","一经","一旦","只要"],"answer":1,"note":"「一经」表示经过这一步以后事情就定了，语体正式。","point":"jingguo"},{"level":6,"section":"grammar","q":"「一经发现，立即处理。」用的是哪个格式？","choices":["到 …… 为止","岂不 …… ？","一经 A，就 B","除此之外，……"],"answer":2,"note":"「一经」表示经过这一步以后事情就定了，语体正式。","point":"jingguo"},{"level":6,"section":"grammar","q":"哪一句用了「一经 A，就 B」？","choices":["一经发现，立即处理。","这点小事，何必惊动大家。","一旦决定了，就不要后悔。","事情还没查清，不宜下结论。"],"answer":0,"note":"「一经」表示经过这一步以后事情就定了，语体正式。","point":"jingguo"},{"level":6,"section":"grammar","q":"这项技术影响全国 ___ 世界。","choices":["乃至","以及","并且","甚至"],"answer":0,"note":"「乃至」是书面的「甚至」，把范围推到最远的一项。","point":"naizhi"},{"level":6,"section":"grammar","q":"几天 ___ 几个月都有可能。","choices":["并且","乃至","甚至","以及"],"answer":1,"note":"「乃至」是书面的「甚至」，把范围推到最远的一项。","point":"naizhi"},{"level":6,"section":"grammar","q":"他的作品在本地 ___ 海外都有读者。","choices":["以及","乃至","甚至","并且"],"answer":1,"note":"「乃至」是书面的「甚至」，把范围推到最远的一项。","point":"naizhi"},{"level":6,"section":"grammar","q":"「这项技术影响全国乃至世界。」用的是哪个格式？","choices":["A、B 乃至 C","……，以免 ……","哪怕 A，也 B","……，进而 ……"],"answer":0,"note":"「乃至」是书面的「甚至」，把范围推到最远的一项。","point":"naizhi"},{"level":6,"section":"grammar","q":"哪一句用了「A、B 乃至 C」？","choices":["凭票入场。","这项技术影响全国乃至世界。","这样岂不更好？","事情还没查清，不宜下结论。"],"answer":1,"note":"「乃至」是书面的「甚至」，把范围推到最远的一项。","point":"naizhi"},{"level":6,"section":"grammar","q":"这样 ___ 更好？","choices":["难道","岂不","何必","莫非"],"answer":1,"note":"「岂不」是书面的反问，等于「难道不……吗」。","point":"qibu"},{"level":6,"section":"grammar","q":"若都如此， ___