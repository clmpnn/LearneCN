anshi"},{"level":6,"section":"grammar","q":"「你不妨问问他。」用的是哪个格式？","choices":["……，进而 ……","不妨 + V","不宜 + V","一经 A，就 B"],"answer":1,"note":"「不妨」表示这样做没有什么妨碍，是一种建议。","point":"zanshi"},{"level":6,"section":"grammar","q":"哪一句用了「不妨 + V」？","choices":["成功在于坚持。","你不妨问问他。","他不见得会来。","所谓效率，就是用最少的时间做最多的事。"],"answer":1,"note":"「不妨」表示这样做没有什么妨碍，是一种建议。","point":"zanshi"},{"level":6,"section":"grammar","q":"天气 ___ 晴，时而雨。","choices":["时而","一边","忽然","有时"],"answer":0,"note":"「时而……时而……」表示两种情况交替出现。","point":"shier"},{"level":6,"section":"grammar","q":"他 ___ 高兴，时而生气。","choices":["一边","时而","忽然","有时"],"answer":1,"note":"「时而……时而……」表示两种情况交替出现。","point":"shier"},{"level":6,"section":"grammar","q":"声音 ___ 大，时而小。","choices":["忽然","有时","时而","一边"],"answer":2,"note":"「时而……时而……」表示两种情况交替出现。","point":"shier"},{"level":6,"section":"grammar","q":"「天气时而晴，时而雨。」用的是哪个格式？","choices":["与其 A，不如 B","不禁 + V","就 A 而言","时而 A，时而 B"],"answer":3,"note":"「时而……时而……」表示两种情况交替出现。","point":"shier"},{"level":6,"section":"grammar","q":"哪一句用了「时而 A，时而 B」？","choices":["天气时而晴，时而雨。","除此之外，还有别的问题。","既然来了，索性多住几天。","唯有坚持，才能成功。"],"answer":0,"note":"「时而……时而……」表示两种情况交替出现。","point":"shier"},{"level":6,"section":"grammar","q":"这样做 ___ 省事，但不安全。","choices":["固然","尽管","虽然","即使"],"answer":0,"note":"「固然」先承认对方有理，再提出自己的看法；「虽然」只是陈述事实。","point":"guran"},{"level":6,"section":"grammar","q":"他 ___ 聪明，可是不够努力。","choices":["尽管","即使","固然","虽然"],"answer":2,"note":"「固然」先承认对方有理，再提出自己的看法；「虽然」只是陈述事实。","point":"guran"},{"level":6,"section":"grammar","q":"价格 ___ 重要，质量更重要。","choices":["虽然","即使","固然","尽管"],"answer":2,"note":"「固然」先承认对方有理，再提出自己的看法；「虽然」只是陈述事实。","point":"guran"},{"level":6,"section":"grammar","q":"「这样做固然省事，但不安全。」用的是哪个格式？","choices":["固然 A，但 B","一来 A，二来 B","针对 + N","岂不 …… ？"],"answer":0,"note":"「固然」先承认对方有理，再提出自己的看法；「虽然」只是陈述事实。","point":"guran"},{"level":6,"section":"grammar","q":"哪一句用了「固然 A，但 B」？","choices":["这样做固然省事，但不安全。","这样下去势必出问题。","他说的无非是这些。","假如你是我，你会怎么做？"],"answer":0,"note":"「固然」先承认对方有理，再提出自己的看法；「虽然」只是陈述事实。","point":"guran"},{"level":6,"section":"grammar","q":"他说的 ___ 是这些。","choices":["不外乎","不过","无非","只是"],"answer":2,"note":"「无非」表示说到底只不过是这样，含轻视的意味。","point":"wufei"},{"level":6,"section":"grammar","q":"原因 ___ 两个。","choices":["只是","不外乎","不过","无非"],"answer":3,"note":"「无非」表示说到底只不过是这样，含轻视的意味。","point":"wufei"},{"level":6,"section":"grammar","q":" ___ 是想引起注意。","choices":["不过","无非","不外乎","只是"],"answer":1,"note":"「无非」表示说到底只不过是这样，含轻视的意味。","point":"wufei"},{"level":6,"section":"grammar","q":"「他说的无非是这些。」用的是哪个格式？","choices":["无非 (是) ……","动辄 + V","不见得 + V","先 ……，继而 ……"],"answer":0,"note":"「无非」表示说到底只不过是这样，含轻视的意味。","point":"wufei"},{"level":6,"section":"grammar","q":"哪一句用了「无非 (是) ……」？","choices":["拿这件事来说，就很清楚。","他说的无非是这些。","倘若明天下雨，运动会就延期。","这个我买不起。"],"answer":1,"note":"「无非」表示说到底只不过是这样，含轻视的意味。","point":"wufei"},{"level":6,"section":"grammar","q":"他没有认真检查， ___ 出了大错。","choices":["于是","以致","从而","因此"],"answer":1,"note":"「以致」后面是不好的结果；「以至于」还可以表示程度深到某种地步。","point":"yizhiyu"},{"level":6,"section":"grammar","q":"雨下得太大， ___ 路都断了。","choices":["以至于","于是","因此","从而"],"answer":0,"note":"「以致」后面是不好的结果；「以至于」还可以表示程度深到某种地步。","point":"yizhiyu"},{"level":6,"section":"grammar","q":"准备不足， ___ 失败。","choices":["因此","以致","从而","于是"],"answer":1,"note":"「以致」后面是不好的结果；「以至于」还可以表示程度深到某种地步。","point":"yizhiyu"},{"level":6,"section":"grammar","q":"「他没有认真检查，以致出了大错。」用的是哪个格式？","choices":["……，以致 ……","万一 A，就 B","A、B 乃至 C","倘若 A，就 B"],"answer":0,"note":"「以致」后面是不好的结果；「以至于」还可以表示程度深到某种地步。","point":"yizhiyu"},{"level":6,"section":"grammar","q":"哪一句用了「……，以致 ……」？","choices":["鉴于时间紧张，会议改期。","这样下去势必出问题。","这本书以历史为主。","他没有认真检查，以致出了大错。"],"answer":3,"note":"「以致」后面是不好的结果；「以至于」还可以表示程度深到某种地步。","point":"yizhiyu"},{"level":6,"section":"grammar","q":" ___ ，他有他的道理，但结论太急了。","choices":["诚然","虽然","固然","当然"],"answer":0,"note":"「诚然」先承认对方说得对，然后提出自己的看法。","point":"chengran"},{"level":6,"section":"grammar","q":" ___ 这需要时间。","choices":["固然","诚然","虽然","当然"],"answer":1,"note":"「诚然」先承认对方说得对，然后提出自己的看法。","point":"chengran"},{"level":6,"section":"grammar","q":" ___ 如此，也不必悲观。","choices":["固然","诚然","当然","虽然"],"answer":1,"note":"「诚然」先承认对方说得对，然后提出自己的看法。","point":"chengran"},{"level":6,"section":"grammar","q":"「诚然，他有他的道理，但结论太急了。」用的是哪个格式？","choices":["诚然 A，但 B","不免 + V","倘若 A，就 B","针对 + N"],"answer":0,"note":"「诚然」先承认对方说得对，然后提出自己的看法。","point":"chengran"},{"level":6,"section":"grammar","q":"哪一句用了「诚然 A，但 B」？","choices":["诚然，他有他的道理，但结论太急了。","他很努力，然而没有成功。","这项技术影响全国乃至世界。","既然来了，索性多住几天。"],"answer":0,"note":"「诚然」先承认对方说得对，然后提出自己的看法。","point":"chengran"},{"level":6,"section":"grammar","q":"原因 ___ 这几种。","choices":["除此之外","总之","不外乎","无非"],"answer":2,"note":"「不外乎」表示范围就这么大，跳不出这几种。","point":"buwaihu"},{"level":6,"section":"grammar","q":"方法 ___ 两个。","choices":["总之","除此之外","无非","不外乎"],"answer":3,"note":"「不外乎」表示范围就这么大，跳不出这几种。","point":"buwaihu"},{"level":6,"section":"grammar","q":"结果 ___ 成功或失败。","choices":["总之","除此之外","无非","不外乎"],"answer":3,"note":"「不外乎」表示范围就这么大，跳不出这几种。","point":"buwaihu"},{"level":6,"section":"grammar","q":"「原因不外乎这几种。」用的是哪个格式？","choices":["惟独 A ……","先 ……，继而 ……","把 A 当作 B","不外乎 ……"],"answer":3,"note":"「不外乎」表示范围就这么大，跳不出这几种。","point":"buwaihu"},{"level":6,"section":"grammar","q":"哪一句用了「不外乎 ……」？","choices":["这个我买不起。","鉴于时间紧张，会议改期。","原因不外乎这几种。","这样说未免太严厉了。"],"answer":2,"note":"「不外乎」表示范围就这么大，跳不出这几种。","point":"buwaihu"},{"level":6,"section":"grammar","q":"既然来了， ___ 多住几天。","choices":["姑且","不妨","索性","干脆"],"answer":2,"note":"「索性」表示干脆彻底地这样做。","point":"suoxing"},{"level":6,"section":"grammar","q":"等不到车， ___ 走回去。","choices":["干脆","姑且","不妨","索性"],"answer":3,"note":"「索性」表示干脆彻底地这样做。","point":"suoxing"},{"level":6,"section":"grammar","q":" ___ 把话说清楚。","choices":["不妨","姑且","干脆","索性"],"answer":3,"note":"「索性」表示干脆彻底地这样做。","point":"suoxing"},{"level":6,"section":"grammar","q":"「既然来了，索性多住几天。」用的是哪个格式？","choices":["从 A 来看","不至于 + V","针对 + N","索性 + V"],"answer":3,"note":"「索性」表示干脆彻底地这样做。","point":"suoxing"},{"level":6,"section":"grammar","q":"哪一句用了「索性 + V」？","choices":["请说慢点，好让大家听清楚。","他没有认真检查，以致出了大错。","既然来了，索性多住几天。","宁可走路，也不坐那么久的车。"],"answer":2,"note":"「索性」表示干脆彻底地这样做。","point":"suoxing"},{"level":6,"section":"grammar","q":"这样下去 ___ 出问题。","choices":["势必","必然","未必","一定"],"answer":0,"note":"「势必」表示照这个趋势一定会这样。","point":"shibi"},{"level":6,"section":"grammar","q":"成本上升 ___ 影响价格。","choices":["势必","必然","未必","一定"],"answer":0,"note":"「势必」表示照这个趋势一定会这样。","point":"shibi"},{"level":6,"section":"grammar","q":" ___ 引起讨论。","choices":["一定","未必","势必","必然"],"answer":2,"note":"「势必」表示照这个趋势一定会这样。","point":"shibi"},{"level":6,"section":"grammar","q":"「这样下去势必出问题。」用的是哪个格式？","choices":["宁可 A，也不 B","在 N 看来","…… 以来","势必 + V"],"answer":3,"note":"「势必」表示照这个趋势一定会这样。","point":"shibi"},{"level":6,"section":"grammar","q":"哪一句用了「势必 + V」？","choices":["这样下去势必出问题。","这样岂不更好？","他靠打工养活自己。","他动辄发脾气。"],"answer":0,"note":"「势必」表示照这个趋势一定会这样。","point":"shibi"},{"level":6,"section":"grammar","q":"这样说 ___ 太严厉了。","choices":["未免","不至于","未必","不免"],"answer":0,"note":"「未免」是委婉地说「有点过分」，「未必」是「不一定」。","point":"weimian"},{"level":6,"section":"grammar","q":"价格 ___ 高了一点。","choices":["不免","不至于","未必","未免"],"answer":3,"note":"「未免」是委婉地说「有点过分」，「未必」是「不一定」。","point":"weimian"},{"level":6,"section":"grammar","q":" ___ 有些可惜。","choices":["不免","未免","不至于","未必"],"answer":1,"note":"「未免」是委婉地说「有点过分」，「未必」是「不一定」。","point":"weimian"},{"level":6,"section":"grammar","q":"「这样说未免太严厉了。」用的是哪个格式？","choices":["就 A 而言","再也不/没 + V","未免 + Adj","势必 + V"],"answer":2,"note":"「未免」是委婉地说「有点过分」，「未必」是「不一定」。","point":"weimian"},{"level":6,"section":"grammar","q":"哪一句用了「未免 + Adj」？","choices":["这点小事，何必惊动大家。","这个问题姑且不谈。","你不妨问问他。","这样说未免太严厉了。"],"answer":3,"note":"「未免」是委婉地说「有点过分」，「未必」是「不一定」。","point":"weimian"},{"level":6,"section":"grammar","q":"听到这个消息，他 ___ 有些失望。","choices":["不至于","难免","不禁","不免"],"answer":3,"note":"「不免」表示这种反应免不了会产生。","point":"bumian"},{"level":6,"section":"grammar","q":"第一次上台， ___ 紧张。","choices":["不至于","不免","难免","不禁"],"answer":1,"note":"「不免」表示这种反应免不了会产生。","point":"bumian"},{"level":6,"section":"grammar","q":"想起往事， ___ 难过。","choices":["不免","不至于","难免","不禁"],"answer":0,"note":"「不免」表示这种反应免不了会产生。","point":"bumian"},{"level":6,"section":"grammar","q":"「听到这个消息，他不免有些失望。」用的是哪个格式？","choices":["不免 + V","把 A 当作 B","诚然 A，但 B","未必 + V"],"answer":0,"note":"「不免」表示这种反应免不了会产生。","point":"bumian"},{"level":6,"section":"grammar","q":"哪一句用了「不免 + V」？","choices":["听到这个消息，他不免有些失望。","这点小事，何必惊动大家。","鉴于时间紧张，会议改期。","这项政策针对年轻人。"],"answer":0,"note":"「不免」表示这种反应免不了会产生。","point":"bumian"},{"level":6,"section":"grammar","q":"这个问题 ___ 不谈。","choices":["暂且","不妨","姑且","索性"],"answer":2,"note":"「姑且」表示暂时先这样，以后再说。","point":"gouqie"},{"level":6,"section":"grammar","q":" ___ 试一试吧。","choices":["不妨","暂且","索性","姑且"],"answer":3,"note":"「姑且」表示暂时先这样，以后再说。","point":"gouqie"},{"level":6,"section":"grammar","q":" ___ 相信他一次。","choices":["暂且","索性","不妨","姑且"],"answer":3,"note":"「姑且」表示暂时先这样，以后再说。","point":"gouqie"},{"level":6,"section":"grammar","q":"「这个问题姑且不谈。」用的是哪个格式？","choices":["倘若 A，就 B","……。至于 A，……","惟独 A ……","姑且 + V"],"answer":3,"note":"「姑且」表示暂时先这样，以后再说。","point":"gouqie"},{"level":6,"section":"grammar","q":"哪一句用了「姑且 + V」？","choices":["这个问题姑且不谈。","事情还没查清，不宜下结论。","东西不错，不过有点贵。","鉴于时间紧张，会议改期。"],"answer":0,"note":"「姑且」表示暂时先这样，以后再说。","point":"gouqie"},{"level":6,"section":"grammar","q":"他说的 ___ 是真的。","choices":["不免","不见得","未必","未免"],"answer":2,"note":"「未必」是书面的「不一定」，表示怀疑而不是否定。","point":"weibi"},{"level":6,"section":"grammar","q":"贵的 ___ 好。","choices":["不免","未必","未免","不见得"],"answer":1,"note":"「未必」是书面的「不一定」，表示怀疑而不是否定。","point":"weibi"},{"level":6,"section":"grammar","q":"这个办法 ___ 行得通。","choices":["未免","不免","不见得","未必"],"answer":3,"note":"「未必」是书面的「不一定」，表示怀疑而不是否定。","point":"weibi"},{"level":6,"section":"grammar","q":"「他说的未必是真的。」用的是哪个格式？","choices":["时而 A，时而 B","……，并且 ……","不妨 + V","未必 + V"],"answer":3,"note":"「未必」是书面的「不一定」，表示怀疑而不是否定。","point":"weibi"},{"level":6,"section":"grammar","q":"哪一句用了「未必 + V」？","choices":["除此之外，还有别的问题。","时间定了。至于地点，还要商量。","他先是吃惊，继而笑了。","他说的未必是真的。"],"answer":3,"note":"「未必」是书面的「不一定」，表示怀疑而不是否定。","point":"weibi"},{"level":6,"section":"grammar","q":"他 ___ 笑了起来。","choices":["不免","难免","不由","不禁"],"answer":3,"note":"「不禁」后面是忍不住做出的动作，「不免」后面多是心理状态。","point":"bujin6"},{"level":6,"section":"grammar","q":"听到这里我 ___ 流下眼泪。","choices":["难免","不免","不禁","不由"],"answer":2,"note":"「不禁」后面是忍不住做出的动作，「不免」后面多是心理状态。","point":"bujin6"},{"level":6,"section":"grammar","q":"大家 ___ 鼓起掌来。","choices":["不由","不免","难免","不禁"],"answer":3,"note":"「不禁」后面是忍不住做出的动作，「不免」后面多是心理状态。","point":"bujin6"},{"level":6,"section":"grammar","q":"「他不禁笑了起来。」用的是哪个格式？","choices":["唯有 A，才 B","不见得 + V","鉴于 A，B","不禁 + V"],"answer":3,"note":"「不禁」后面是忍不住做出的动作，「不免」后面多是心理状态。","point":"bujin6"},{"level":6,"section":"grammar","q":"哪一句用了「不禁 + V」？","choices":["他不禁笑了起来。","一旦决定了，就不要后悔。","他靠打工养活自己。","这本书以历史为主。"],"answer":0,"note":"「不禁」后面是忍不住做出的动作，「不免」后面多是心理状态。","point":"bujin6"},{"level":6,"section":"grammar","q":" ___ 明天下雨，运动会就延期。","choices":["如果","倘若","既然","假如"],"answer":1,"note":"「倘若」是书面语的「如果」，多用于正式文字。","point":"tangruo"},{"level":6,"section":"grammar","q":" ___ 有困难，请及时联系。","choices":["假如","倘若","既然","如果"],"answer":1,"note":"「倘若」是书面语的「如果」，多用于正式文字。","point":"tangruo"},{"level":6,"section":"grammar","q":" ___ 属实，后果严重。","choices":["倘若","假如","既然","如果"],"answer":0,"note":"「倘若」是书面语的「如果」，多用于正式文字。","point":"tangruo"},{"level":6,"section":"grammar","q":"「倘若明天下雨，运动会就延期。」用的是哪个格式？","choices":["倘若 A，就 B","哪怕 A，也 B","何尝 …… ？","……，不过 ……"],"answer":0,"note":"「倘若」是书面语的「如果」，多用于正式文字。","point":"tangruo"},{"level":6,"section":"grammar","q":"哪一句用了「倘若 A，就 B」？","choices":["他说的无非是这些。","这本书以历史为主。","成功在于坚持。","倘若明天下雨，运动会就延期。"],"answer":3,"note":"「倘若」是书面语的「如果」，多用于正式文字。","point":"tangruo"},{"level":6,"section":"grammar","q":"工作中 ___ 出错。","choices":["免不了","不免","不禁","难免"],"answer":3,"note":"「难免」表示不容易避免，可以做谓语，也可以修饰后面的句子。","point":"nanmian"},{"level":6,"section":"grammar","q":"他年纪小， ___ 不懂事。","choices":["不免","不禁","难免","免不了"],"answer":2,"note":"「难免」表示不容易避免，可以做谓语，也可以修饰后面的句子。","point":"nanmian"},{"level":6,"section":"grammar","q":"这样做 ___ 引起误会。","choices":["不免","免不了","难免","不禁"],"answer":2,"note":"「难免」表示不容易避免，可以做谓语，也可以修饰后面的句子。","point":"nanmian"},{"level":6,"section":"grammar","q":"「工作中难免出错。」用的是哪个格式？","choices":["不外乎 ……","唯有 A，才 B","……，进而 ……","难免 + V"],"answer":3,"note":"「难免」表示不容易避免，可以做谓语，也可以修饰后面的句子。","point":"nanmian"},{"level":6,"section":"grammar","q":"哪一句用了「难免 + V」？","choices":["这个问题姑且不谈。","工作中难免出错。","这样做固然省事，但不安全。","他动辄发脾气。"],"answer":1,"note":"「难免」表示不容易避免，可以做谓语，也可以修饰后面的句子。","point":"nanmian"},{"level":6,"section":"grammar","q":" ___ 你是我，你会怎么做？","choices":["倘若","除非","假如","既然"],"answer":2,"note":"「假如」用于假设，语气比「如果」更像是设想。","point":"jiaru"},{"level":6,"section":"grammar","q":" ___ 再来一次，我还是这样选。","choices":["假如","既然","除非","倘若"],"answer":0,"note":"「假如」用于假设，语气比「如果」更像是设想。","point":"jiaru"},{"level":6,"section":"grammar","q":" ___ 没有他，就没有今天。","choices":["假如","既然","除非","倘若"],"answer":0,"note":"「假如」用于假设，语气比「如果」更像是设想。","point":"jiaru"},{"level":6,"section":"grammar","q":"「假如你是我，你会怎么做？」用的是哪个格式？","choices":["假如 A，就 B","就算 A，也 B","诚然 A，但 B","……。至于 A，……"],"answer":0,"note":"「假如」用于假设，语气比「如果」更像是设想。","point":"jiaru"},{"level":6,"section":"grammar","q":"哪一句用了「假如 A，就 B」？","choices":["大家都同意，惟独他反对。","带上伞，万一下雨呢。","假如你是我，你会怎么做？","唯有坚持，才能成功。"],"answer":2,"note":"「假如」用于假设，语气比「如果」更像是设想。","point":"jiaru"}]