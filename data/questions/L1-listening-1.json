[{"level":1,"section":"listening","q":"说话人在做什么？","choices":["自我介绍","问路","买东西","告别"],"answer":0,"note":"「我叫李月」是在说自己的名字。","speak":"你好！我叫李月。"},{"level":1,"section":"listening","q":"说话人说了什么？","choices":["他会说汉语","他不会说汉语","他在学汉语","他是中国人"],"answer":1,"note":"「不会」表示没有这个本领。","speak":"对不起，我不会说汉语。"},{"level":1,"section":"listening","q":"应该怎么回答？","choices":["没关系","对不起","不客气","你好"],"answer":2,"note":"「不客气」回答「谢谢」。","speak":"谢谢你！"},{"level":1,"section":"listening","q":"说话人在问什么？","choices":["年龄","价钱","地方","名字"],"answer":3,"note":"「叫什么名字」问的是名字。","speak":"请问，你叫什么名字？"},{"level":1,"section":"listening","q":"说话人是谁？","choices":["学生","老师","医生","没有说"],"answer":0,"note":"先否定「不是老师」，再说「我是学生」。","speak":"我不是老师，我是学生。"},{"level":1,"section":"listening","q":"他家有几个人？","choices":["一个","三个","两个","四个"],"answer":1,"note":"「三个人」。","speak":"我家有三个人。"},{"level":1,"section":"listening","q":"今天天气怎么样？","choices":["下雨","很冷","很好","很热"],"answer":2,"note":"「很好」。","speak":"今天天气很好。"},{"level":1,"section":"listening","q":"他想喝什么？","choices":["水","咖啡","牛奶","茶"],"answer":3,"note":"「喝一点儿茶」。","speak":"我想喝一点儿茶。"},{"level":1,"section":"listening","q":"说话人觉得怎么样？","choices":["价钱太高","价钱便宜","东西很好","东西太小"],"answer":0,"note":"「太贵了」是嫌价钱高。","speak":"这个太贵了。"},{"level":1,"section":"listening","q":"说话人在哪儿？","choices":["家里","学校","商店","医院"],"answer":1,"note":"「我在学校」。","speak":"我在学校，你在哪儿？"},{"level":1,"section":"listening","q":"他们什么时候见面？","choices":["今天下午三点","明天上午三点","明天下午三点","明天下午两点"],"answer":2,"note":"「明天下午三点」。","speak":"明天下午三点见。"},{"level":1,"section":"listening","q":"说话人在问什么？","choices":["大小","颜色","价钱","地址"],"answer":2,"note":"录音原文：这个多少钱？","speak":"这个多少钱？"},{"level":1,"section":"listening","q":"说话人在问什么？","choices":["价钱","时间","名字","地方"],"answer":1,"note":"录音原文：现在几点了？","speak":"现在几点了？"},{"level":1,"section":"listening","q":"说话人在做什么？","choices":["问路","点菜","自我介绍","告别"],"answer":2,"note":"录音原文：你好，我叫王明。","speak":"你好，我叫王明。"},{"level":1,"section":"listening","q":"说话人想要什么？","choices":["咖啡","米饭","茶","水"],"answer":3,"note":"录音原文：我想喝水。","speak":"我想喝水。"},{"level":1,"section":"listening","q":"他们什么时候见面？","choices":["下星期","今天晚上","明天","今天"],"answer":2,"note":"录音原文：明天见！","speak":"明天见！"}]