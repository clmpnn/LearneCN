[{"level":2,"section":"grammar","q":"请 ___ 我一杯茶。","choices":["给","让","对","比"],"answer":0,"note":"「给」后面接接受的人：给我一杯茶、给他打电话。"},{"level":2,"section":"grammar","q":"___ 我家 ___ 学校，走路要半个小时。","choices":["因为…所以","从…到","虽然…但是","一边…一边"],"answer":1,"note":"「从 A 到 B」说的是起点和终点，时间和地点都能用。"},{"level":2,"section":"grammar","q":"他 ___ 高兴，笑了很久。","choices":["已经","正在","非常","一起"],"answer":2,"note":"「非常」比「很」的程度更高，后面接形容词。"},{"level":2,"section":"grammar","q":"我 ___ 吃过午饭了。","choices":["正在","就要","刚才","已经"],"answer":3,"note":"「已经…了」表示事情在说话之前就完成了。"},{"level":2,"section":"grammar","q":"我们 ___ 去看电影吧。","choices":["一起","一下","一点儿","一次"],"answer":0,"note":"「一起」表示几个人共同做一件事，放在动词前面。"},{"level":2,"section":"grammar","q":"请等 ___ 。","choices":["一起","一下","一点儿","一天"],"answer":1,"note":"「一下」放在动词后面，把语气变轻：看一下、等一下。"},{"level":2,"section":"grammar","q":"他 ___ 我这件事了。","choices":["说","讲","告诉","问"],"answer":2,"note":"「告诉」后面可以直接跟人：告诉我。「说」不能这样用，要说「对我说」。"},{"level":2,"section":"grammar","q":"你 ___ 不来？","choices":["什么","怎么样","哪儿","为什么"],"answer":3,"note":"问原因用「为什么」，回答常常用「因为」。"},{"level":2,"section":"grammar","q":"我 ___ 这个电影很好看。","choices":["觉得","知道","告诉","希望"],"answer":0,"note":"「觉得」引出自己的看法，后面跟一个完整的句子。"},{"level":2,"section":"grammar","q":"这里人很多，你 ___ 坐这儿。","choices":["可能","可以","一定","或者"],"answer":1,"note":"「可以」表示允许或者建议；「可能」说的是有这个机会。"},{"level":2,"section":"grammar","q":"我 ___ 明天不下雨。","choices":["觉得","知道","希望","告诉"],"answer":2,"note":"「希望」表示愿望，说的是还没有发生的事。"},{"level":2,"section":"grammar","q":"这个字 ___ 写？","choices":["什么","多少","哪儿","怎么"],"answer":3,"note":"「怎么」问方式方法：怎么写、怎么走、怎么办。"},{"level":2,"section":"grammar","q":"他 ___ 吃饭 ___ 看电视。","choices":["一边…一边","虽然…但是","因为…所以","不但…而且"],"answer":0,"note":"「一边…一边」表示两个动作同时进行。"},{"level":2,"section":"grammar","q":"他 ___ 洗澡呢。","choices":["正在","就要","刚才","已经"],"answer":0,"note":"「正在…呢」表示动作此刻正在进行。"},{"level":2,"section":"grammar","q":"我去 ___ 北京，那里很美。","choices":["过","了","在","着"],"answer":0,"note":"「过」表示曾经有过这样的经历。"},{"level":2,"section":"grammar","q":"___ 下雨了，___ 我们不去公园。","choices":["不但…而且","如果…就","因为…所以","虽然…但是"],"answer":2,"note":"「因为…所以」先说原因，后说结果。"},{"level":2,"section":"grammar","q":"我昨天看 ___ 一部电影。","choices":["过","了","着","的"],"answer":1,"note":"动词后面的「了」表示动作已经完成。"},{"level":2,"section":"grammar","q":"他跑 ___ 很快。","choices":["的","了","得","地"],"answer":2,"note":"「得」引出补语，说明动作达到的程度：跑得很快。"},{"level":2,"section":"grammar","q":"___ 很累，___ 他还在工作。","choices":["因为…所以","越…越","只要…就","虽然…但是"],"answer":3,"note":"「虽然…但是」先让步，后转折。"},{"level":2,"section":"grammar","q":"今天 ___ 昨天热。","choices":["跟","比","和","像"],"answer":1,"note":"「A 比 B + 形容词」是最常用的比较格式：今天比昨天热。"},{"level":2,"section":"grammar","q":"我 ___ 你打电话。","choices":["对","让","给","跟"],"answer":2,"note":"「给」引出接受的人，放在动词前面；单独用时是「给予」的意思。","point":"gei"},{"level":2,"section":"grammar","q":"他 ___ 我买了一本书。","choices":["跟","给","对","让"],"answer":1,"note":"「给」引出接受的人，放在动词前面；单独用时是「给予」的意思。","point":"gei"},{"level":2,"section":"grammar","q":"请 ___ 我一杯水。","choices":["给","对","让","跟"],"answer":0,"note":"「给」引出接受的人，放在动词前面；单独用时是「给予」的意思。","point":"gei"},{"level":2,"section":"grammar","q":"「我给你打电话。」用的是哪个格式？","choices":["A 在 + place","A 是 B","V + 了 + Num + 次/遍","给 + N + V"],"answer":3,"note":"「给」引出接受的人，放在动词前面；单独用时是「给予」的意思。","point":"gei"},{"level":2,"section":"grammar","q":"哪一句用了「给 + N + V」？","choices":["他进来了。","我给你打电话。","他七点就来了。","我每天都跑步。"],"answer":1,"note":"「给」引出接受的人，放在动词前面；单独用时是「给予」的意思。","point":"gei"},{"level":2,"section":"grammar","q":"下雨 ___ 。","choices":["着","的","了","过"],"answer":2,"note":"句末的「了」表示情况发生了变化，和动词后的「了」不一样。","point":"le2"},{"level":2,"section":"grammar","q":"他长大 ___ 。","choices":["的","了","过","着"],"answer":1,"note":"句末的「了」表示情况发生了变化，和动词后的「了」不一样。","point":"le2"},{"level":2,"section":"grammar","q":"我不去 ___ 。","choices":["过","了","的","着"],"answer":1,"note":"句末的「了」表示情况发生了变化，和动词后的「了」不一样。","point":"le2"},{"level":2,"section":"grammar","q":"「下雨了。」用的是哪个格式？","choices":["…… 了","S 把 O + V + 结果","一定 + V","N/Pron + 的 + N"],"answer":0,"note":"句末的「了」表示情况发生了变化，和动词后的「了」不一样。","point":"le2"},{"level":2,"section":"grammar","q":"哪一句用了「…… 了」？","choices":["下雨了。","我会说汉语。","这个菜又便宜又好吃。","请把门关上。"],"answer":0,"note":"句末的「了」表示情况发生了变化，和动词后的「了」不一样。","point":"le2"},{"level":2,"section":"grammar","q":"我 ___ 坐飞机来的。","choices":["在","了","是","过"],"answer":2,"note":"动作已经发生，要问或强调时间、地点、方式，就用「是……的」。","point":"shide"},{"level":2,"section":"grammar","q":"你是什么时候来 ___ ？","choices":["在","了","过","的"],"answer":3,"note":"动作已经发生，要问或强调时间、地点、方式，就用「是……的」。","point":"shide"},{"level":2,"section":"grammar","q":"这本书是在北京买 ___ 。","choices":["过","的","了","相反"],"answer":1,"note":"动作已经发生，要问或强调时间、地点、方式，就用「是……的」。","point":"shide"},{"level":2,"section":"grammar","q":"「我是坐飞机来的。」用的是哪个格式？","choices":["又 A 又 B","先 A，然后 B","是 …… 的","能 + V"],"answer":2,"note":"动作已经发生，要问或强调时间、地点、方式，就用「是……的」。","point":"shide"},{"level":2,"section":"grammar","q":"哪一句用了「是 …… 的」？","choices":["我每天都跑步。","我是坐飞机来的。","即使下雨，我们也要去。","别去了。"],"answer":1,"note":"动作已经发生，要问或强调时间、地点、方式，就用「是……的」。","point":"shide"},{"level":2,"section":"grammar","q":"他 ___ 我笑了。","choices":["给","跟","对","和"],"answer":2,"note":"「对」引出动作的对象，放在动词前面。","point":"dui"},{"level":2,"section":"grammar","q":"这 ___ 身体很好。","choices":["和","对","给","跟"],"answer":1,"note":"「对」引出动作的对象，放在动词前面。","point":"dui"},{"level":2,"section":"grammar","q":"她 ___ 我说了一句话。","choices":["跟","对","和","给"],"answer":1,"note":"「对」引出动作的对象，放在动词前面。","point":"dui"},{"level":2,"section":"grammar","q":"「他对我笑了。」用的是哪个格式？","choices":["关于 + N","V + 了 + Num + 次/遍","…… 以前 / 以后","对 + N + V"],"answer":3,"note":"「对」引出动作的对象，放在动词前面。","point":"dui"},{"level":2,"section":"grammar","q":"哪一句用了「对 + N + V」？","choices":["他对我笑了。","我今天不能来。","他在做饭呢。","先洗手，然后吃饭。"],"answer":0,"note":"「对」引出动作的对象，放在动词前面。","point":"dui"},{"level":2,"section":"grammar","q":" ___ 北京到上海很远。","choices":["从","在","往","离"],"answer":0,"note":"「从……到……」表示时间或空间的起点和终点。","point":"congdao"},{"level":2,"section":"grammar","q":"我从八点学 ___ 十二点。","choices":["在","到","离","往"],"answer":1,"note":"「从……到……」表示时间或空间的起点和终点。","point":"congdao"},{"level":2,"section":"grammar","q":" ___ 这儿到学校要多久？","choices":["在","离","从","往"],"answer":2,"note":"「从……到……」表示时间或空间的起点和终点。","point":"congdao"},{"level":2,"section":"grammar","q":"「从北京到上海很远。」用的是哪个格式？","choices":["Num + MW + N","S 把 O + V + 结果","V + 了 + duration","从 A 到 B"],"answer":3,"note":"「从……到……」表示时间或空间的起点和终点。","point":"congdao"},{"level":2,"section":"grammar","q":"哪一句用了「从 A 到 B」？","choices":["这个字我看不清楚。","从北京到上海很远。","他是谁？","今天是三月五号。"],"answer":1,"note":"「从……到……」表示时间或空间的起点和终点。","point":"congdao"},{"level":2,"section":"grammar","q":"他 ___ 做饭呢。","choices":["过","着","在","了"],"answer":2,"note":"「在」放在动词前表示动作正在进行，句末可以加「呢」。","point":"zhengzai"},{"level":2,"section":"grammar","q":"我 ___ 看书。","choices":["正在","过","了","着"],"answer":0,"note":"「在」放在动词前表示动作正在进行，句末可以加「呢」。","point":"zhengzai"},{"level":2,"section":"grammar","q":"你 ___ 干什么？","choices":["着","在","了","过"],"answer":1,"note":"「在」放在动词前表示动作正在进行，句末可以加「呢」。","point":"zhengzai"},{"level":2,"section":"grammar","q":"「他在做饭呢。」用的是哪个格式？","choices":["(正)在 + V + 呢","请 + V","只要 A，就 B","…… 什么 ……？"],"answer":0,"note":"「在」放在动词前表示动作正在进行，句末可以加「呢」。","point":"zhengzai"},{"level":2,"section":"grammar","q":"哪一句用了「(正)在 + V + 呢」？","choices":["他在做饭呢。","我们都是学生。","我跟朋友一起去。","火车要开了。"],"answer":0,"note":"「在」放在动词前表示动作正在进行，句末可以加「呢」。","point":"zhengzai"},{"level":2,"section":"grammar","q":"妈妈 ___ 我早点回家。","choices":["被","叫","给","让"],"answer":3,"note":"「让」后面先说人，再说他做什么。","point":"rang"},{"level":2,"section":"grammar","q":" ___ 我看看。","choices":["被","给","让","叫"],"answer":2,"note":"「让」后面先说人，再说他做什么。","point":"rang"},{"level":2,"section":"grammar","q":"老师 ___ 我们写作业。","choices":["叫","被","给","让"],"answer":3,"note":"「让」后面先说人，再说他做什么。","point":"rang"},{"level":2,"section":"grammar","q":"「妈妈让我早点回家。」用的是哪个格式？","choices":["让 + N + V","S 被 (N) + V + 了","(正)在 + V + 呢","V + 来/去"],"answer":0,"note":"「让」后面先说人，再说他做什么。","point":"rang"},{"level":2,"section":"grammar","q":"哪一句用了「让 + N + V」？","choices":["我吃了饭。","妈妈让我早点回家。","我也是学生。","我很喜欢喝茶。"],"answer":1,"note":"「让」后面先说人，再说他做什么。","point":"rang"},{"level":2,"section":"grammar","q":"火车 ___ 开了。","choices":["会","过","要","在"],"answer":2,"note":"「快要……了」表示事情马上就要发生。","point":"yaole"},{"level":2,"section":"grammar","q":" ___ 下雨了。","choices":["快要","在","过","会"],"answer":0,"note":"「快要……了」表示事情马上就要发生。","point":"yaole"},{"level":2,"section":"grammar","q":"他 ___ 来了。","choices":["在","过","就要","会"],"answer":2,"note":"「快要……了」表示事情马上就要发生。","point":"yaole"},{"level":2,"section":"grammar","q":"「火车要开了。」用的是哪个格式？","choices":["(快)要 + V + 了","A 比 B + Adj","快 + V + 了","只要 A，就 B"],"answer":0,"note":"「快要……了」表示事情马上就要发生。","point":"yaole"},{"level":2,"section":"grammar","q":"哪一句用了「(快)要 + V + 了」？","choices":["我吃了饭。","你在哪儿？","我明天去。","火车要开了。"],"answer":3,"note":"「快要……了」表示事情马上就要发生。","point":"yaole"},{"level":2,"section":"grammar","q":"他说 ___ 很好。","choices":["的","地","得","了"],"answer":2,"note":"「得」后面说的是动作做得怎么样。带宾语时动词要重复：他说汉语说得很好。","point":"debu"},{"level":2,"section":"grammar","q":"你跑 ___ 太快了。","choices":["一来","得","地","的"],"answer":1,"note":"「得」后面说的是动作做得怎么样。带宾语时动词要重复：他说汉语说得很好。","point":"debu"},{"level":2,"section":"grammar","q":"她汉语说 ___ 不错。","choices":["地","得","了","的"],"answer":1,"note":"「得」后面说的是动作做得怎么样。带宾语时动词要重复：他说汉语说得很好。","point":"debu"},{"level":2,"section":"grammar","q":"「他说得很好。」用的是哪个格式？","choices":["V + 得 + Adj","Num 点 Num 分","让 + N + V","一 V₁ 就 V₂"],"answer":0,"note":"「得」后面说的是动作做得怎么样。带宾语时动词要重复：他说汉语说得很好。","point":"debu"},{"level":2,"section":"grammar","q":"哪一句用了「V + 得 + Adj」？","choices":["我明天去。","他说得很好。","他进来了。","我的自行车被人偷了。"],"answer":1,"note":"「得」后面说的是动作做得怎么样。带宾语时动词要重复：他说汉语说得很好。","point":"debu"},{"level":2,"section":"grammar","q":"他 ___ 在睡觉。","choices":["又","还","也","再"],"answer":1,"note":"「还」表示情况在继续，或者还有别的。","point":"hai"},{"level":2,"section":"grammar","q":"我 ___ 想买一本。","choices":["再","又","还","也"],"answer":2,"note":"「还」表示情况在继续，或者还有别的。","point":"hai"},{"level":2,"section":"grammar","q":"你 ___ 有别的问题吗？","choices":["也","再","又","还"],"answer":3,"note":"「还」表示情况在继续，或者还有别的。","point":"hai"},{"level":2,"section":"grammar","q":"「他还在睡觉。」用的是哪个格式？","choices":["多少 + (MW) + N","两 + MW","A 是 B","还 + V"],"answer":3,"note":"「还」表示情况在继续，或者还有别的。","point":"hai"},{"level":2,"section":"grammar","q":"哪一句用了「还 + V」？","choices":["我有两个哥哥。","太好了！","我一到家就给你打电话。","他还在睡觉。"],"answer":3,"note":"「还」表示情况在继续，或者还有别的。","point":"hai"},{"level":2,"section":"grammar","q":"我去 ___ 中国。","choices":["着","过","了","的"],"answer":1,"note":"「过」表示曾经有过这个经历，「了」表示某件事做完了。","point":"guo"},{"level":2,"section":"grammar","q":"你吃 ___ 北京烤鸭吗？","choices":["着","的","了","过"],"answer":3,"note":"「过」表示曾经有过这个经历，「了」表示某件事做完了。","point":"guo"},{"level":2,"section":"grammar","q":"他没看 ___ 这个电影。","choices":["过","着","了","的"],"answer":0,"note":"「过」表示曾经有过这个经历，「了」表示某件事做完了。","point":"guo"},{"level":2,"section":"grammar","q":"「我去过中国。」用的是哪个格式？","choices":["跟 + N + V","V V / V 一 V","V + 过","A 没有 B (这么) Adj"],"answer":2,"note":"「过」表示曾经有过这个经历，「了」表示某件事做完了。","point":"guo"},{"level":2,"section":"grammar","q":"哪一句用了「V + 过」？","choices":["我是坐飞机来的。","他总是迟到。","我学了三年汉语。","我去过中国。"],"answer":3,"note":"「过」表示曾经有过这个经历，「了」表示某件事做完了。","point":"guo"},{"level":2,"section":"grammar","q":"我有 ___ 个哥哥。","choices":["量词","几","两","半"],"answer":2,"note":"数东西用「两」，说数字本身用「二」：两个人、二月、十二。","point":"liang"},{"level":2,"section":"grammar","q":"现在 ___ 点半。","choices":["先","两","几","量词"],"answer":1,"note":"数东西用「两」，说数字本身用「二」：两个人、二月、十二。","point":"liang"},{"level":2,"section":"grammar","q":" ___ 月有二十八天。","choices":["二","几","半","量词"],"answer":0,"note":"数东西用「两」，说数字本身用「二」：两个人、二月、十二。","point":"liang"},{"level":2,"section":"grammar","q":"「我有两个哥哥。」用的是哪个格式？","choices":["…… 的时候","一定 + V","只有 A，才 B","两 + MW"],"answer":3,"note":"数东西用「两」，说数字本身用「二」：两个人、二月、十二。","point":"liang"},{"level":2,"section":"grammar","q":"哪一句用了「两 + MW」？","choices":["我给你打电话。","我在家。","书在桌子上。","我有两个哥哥。"],"answer":3,"note":"数东西用「两」，说数字本身用「二」：两个人、二月、十二。","point":"liang"},{"level":2,"section":"grammar","q":"我每天 ___ 跑步。","choices":["也","都","还","就"],"answer":1,"note":"「每」后面的句子常常要有「都」呼应。","point":"meidou"},{"level":2,"section":"grammar","q":"每个人 ___ 来了。","choices":["也","还","都","就"],"answer":2,"note":"「每」后面的句子常常要有「都」呼应。","point":"meidou"},{"level":2,"section":"grammar","q":"他每次 ___ 迟到。","choices":["就","还","也","都"],"answer":3,"note":"「每」后面的句子常常要有「都」呼应。","point":"meidou"},{"level":2,"section":"grammar","q":"「我每天都跑步。」用的是哪个格式？","choices":["S + 也 + V","为了 + purpose，……","每 + MW + N + 都","多少 + (MW) + N"],"answer":2,"note":"「每」后面的句子常常要有「都」呼应。","point":"meidou"},{"level":2,"section":"grammar","q":"哪一句用了「每 + MW + N + 都」？","choices":["我也是学生。","我每天都跑步。","从北京到上海很远。","你叫什么名字？"],"answer":1,"note":"「每」后面的句子常常要有「都」呼应。","point":"meidou"},{"level":2,"section":"grammar","q":" ___ 去了。","choices":["请","别","不","没"],"answer":1,"note":"「别」和「不要」都是劝阻，「别」更口语。","point":"bie"},{"level":2,"section":"grammar","q":" ___ 说话！","choices":["没","不","请","别"],"answer":3,"note":"「别」和「不要」都是劝阻，「别」更口语。","point":"bie"},{"level":2,"section":"grammar","q":"你 ___ 担心。","choices":["别","不","请","没"],"answer":0,"note":"「别」和「不要」都是劝阻，「别」更口语。","point":"bie"},{"level":2,"section":"grammar","q":"「别去了。」用的是哪个格式？","choices":["通过 + N，……","别 + V","谁 / …… 是谁？","V + 出来"],"answer":1,"note":"「别」和「不要」都是劝阻，「别」更口语。","point":"bie"},{"level":2,"section":"grammar","q":"哪一句用了「别 + V」？","choices":["别去了。","只有努力，才能学好汉语。","我是坐飞机来的。","他一边走一边听音乐。"],"answer":0,"note":"「别」和「不要」都是劝阻，「别」更口语。","point":"bie"},{"level":2,"section":"grammar","q":"他 ___ 我高。","choices":["一样","比","跟","没有"],"answer":1,"note":"「比」字句里不能用「很」「非常」，程度放在形容词后面：大一点儿、大得多。","point":"bi"},{"level":2,"section":"grammar","q":"今天 ___ 昨天冷。","choices":["一样","比","跟","没有"],"answer":1,"note":"「比」字句里不能用「很」「非常」，程度放在形容词后面：大一点儿、大得多。","point":"bi"},{"level":2,"section":"grammar","q":"这个 ___ 那个贵一点儿。","choices":["跟","一样","比","没有"],"answer":2,"note":"「比」字句里不能用「很」「非常」，程度放在形容词后面：大一点儿、大得多。","point":"bi"},{"level":2,"section":"grammar","q":"「他比我高。」用的是哪个格式？","choices":["…… 的话","V + 来/去","A 比 B + Adj","不但 A，而且 B"],"answer":2,"note":"「比」字句里不能用「很」「非常」，程度放在形容词后面：大一点儿、大得多。","point":"bi"},{"level":2,"section":"grammar","q":"哪一句用了「A 比 B + Adj」？","choices":["今天是三月五号。","我的自行车被人偷了。","他比我高。","我没有他高。"],"answer":2,"note":"「比」字句里不能用「很」「非常」，程度放在形容词后面：大一点儿、大得多。","point":"bi"},{"level":2,"section":"grammar","q":" ___ 下雨，所以我没去。","choices":["如果","因为","虽然","但是"],"answer":1,"note":"「因为」和「所以」常常一起出现，两个都说才完整。","point":"yinwei"},{"level":2,"section":"grammar","q":"因为他病了， ___ 没来上课。","choices":["所以","但是","如果","虽然"],"answer":0,"note":"「因为」和「所以」常常一起出现，两个都说才完整。","point":"yinwei"},{"level":2,"section":"grammar","q":"我喜欢中国， ___ 这里的人很好。","choices":["因为","但是","虽然","如果"],"answer":0,"note":"「因为」和「所以」常常一起出现，两个都说才完整。","point":"yinwei"},{"level":2,"section":"grammar","q":"「因为下雨，所以我没去。」用的是哪个格式？","choices":["A 没有 B (这么) Adj","因为 A，所以 B","V + 了","V + 了 + Num + 次/遍"],"answer":1,"note":"「因为」和「所以」常常一起出现，两个都说才完整。","point":"yinwei"},{"level":2,"section":"grammar","q":"哪一句用了「因为 A，所以 B」？","choices":["我看了三次。","因为下雨，所以我没去。","现在几点？","他不但会说汉语，而且说得很好。"],"answer":1,"note":"「因为」和「所以」常常一起出现，两个都说才完整。","point":"yinwei"},{"level":2,"section":"grammar","q":" ___ 到了。","choices":["要","快","还","就"],"answer":1,"note":"「快……了」强调时间上快到了。","point":"kuai"},{"level":2,"section":"grammar","q":"他 ___ 毕业了。","choices":["还","要","就","快"],"answer":3,"note":"「快……了」强调时间上快到了。","point":"kuai"},{"level":2,"section":"grammar","q":" ___ 十二点了。","choices":["就","还","要","快"],"answer":3,"note":"「快……了」强调时间上快到了。","point":"kuai"},{"level":2,"section":"grammar","q":"「快到了。」用的是哪个格式？","choices":["V + 过","…… 的时候","快 + V + 了","V + 起来"],"answer":2,"note":"「快……了」强调时间上快到了。","point":"kuai"},{"level":2,"section":"grammar","q":"哪一句用了「快 + V + 了」？","choices":["快到了。","你应该多休息。","这是我的书。","即使下雨，我们也要去。"],"answer":0,"note":"「快……了」强调时间上快到了。","point":"kuai"},{"level":2,"section":"grammar","q":"他进 ___ 了。","choices":["到","来","在","结果补语"],"answer":1,"note":"「来」「去」放在动词后面，说明动作朝着说话人还是离开说话人。","point":"fangxiang"},{"level":2,"section":"grammar","q":"请拿 ___ 吧。","choices":["在","到","结果补语","去"],"answer":3,"note":"「来」「去」放在动词后面，说明动作朝着说话人还是离开说话人。","point":"fangxiang"},{"level":2,"section":"grammar","q":"我上 ___ 看看。","choices":["去","到","在","结果补语"],"answer":0,"note":"「来」「去」放在动词后面，说明动作朝着说话人还是离开说话人。","point":"fangxiang"},{"level":2,"section":"grammar","q":"「他进来了。」用的是哪个格式？","choices":["V + 来/去","S 把 O + V + 结果","虽然 A，但是 B","从 A 到 B"],"answer":0,"note":"「来」「去」放在动词后面，说明动作朝着说话人还是离开说话人。","point":"fangxiang"},{"level":2,"section":"grammar","q":"哪一句用了「V + 来/去」？","choices":["他不但会说汉语，而且说得很好。","他进来了。","这是我的书。","好极了！"],"answer":1,"note":"「来」「去」放在动词后面，说明动作朝着说话人还是离开说话人。","point":"fangxiang"},{"level":2,"section":"grammar","q":"我 ___ 他高。","choices":["不比","没有","比","一样"],"answer":1,"note":"「A没有B那么……」是「比不上」；「不比」只是否定「比」，意思不一样。","point":"meiyoubi"},{"level":2,"section":"grammar","q":"今天 ___ 昨天那么冷。","choices":["比","没有","不比","一样"],"answer":1,"note":"「A没有B那么……」是「比不上」；「不比」只是否定「比」，意思不一样。","point":"meiyoubi"},{"level":2,"section":"grammar","q":"这个 ___ 那个好。","choices":["没有","不比","一样","比"],"answer":0,"note":"「A没有B那么……」是「比不上」；「不比」只是否定「比」，意思不一样。","point":"meiyoubi"},{"level":2,"section":"grammar","q":"「我没有他高。」用的是哪个格式？","choices":["N 和 N","跟 + N + V","这/那 + MW + N","A 没有 B (这么) Adj"],"answer":3,"note":"「A没有B那么……」是「比不上」；「不比」只是否定「比」，意思不一样。","point":"meiyoubi"},{"level":2,"section":"grammar","q":"哪一句用了「A 没有 B (这么) Adj」？","choices":["你有几个朋友？","我没有他高。","差不多十个人。","你看看这个。"],"answer":1,"note":"「A没有B那么……」是「比不上」；「不比」只是否定「比」，意思不一样。","point":"meiyoubi"},{"level":2,"section":"grammar","q":"这个 ___ 贵。","choices":["一点儿","很","太","有点儿"],"answer":3,"note":"「有点儿」在形容词前，含不满意的意思；「一点儿」在形容词后，只表示程度小。","point":"youdianr"},{"level":2,"section":"grammar","q":"我 ___ 累。","choices":["很","太","一点儿","有点儿"],"answer":3,"note":"「有点儿」在形容词前，含不满意的意思；「一点儿」在形容词后，只表示程度小。","point":"youdianr"},{"level":2,"section":"grammar","q":"今天 ___ 冷。","choices":["太","很","一点儿","有点儿"],"answer":3,"note":"「有点儿」在形容词前，含不满意的意思；「一点儿」在形容词后，只表示程度小。","point":"youdianr"},{"level":2,"section":"grammar","q":"「这个有点儿贵。」用的是哪个格式？","choices":["有点儿 + Adj","在 / 去 + 哪儿？","快 + V + 了","喜欢 + N/V"],"answer":0,"note":"「有点儿」在形容词前，含不满意的意思；「一点儿」在形容词后，只表示程度小。","point":"youdianr"},{"level":2,"section":"grammar","q":"哪一句用了「有点儿 + Adj」？","choices":["妈妈让我早点回家。","这个有点儿贵。","明天再来吧。","我跟朋友一起去。"],"answer":1,"note":"「有点儿」在形容词前，含不满意的意思